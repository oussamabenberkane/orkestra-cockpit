# --- Orkestra Cockpit — agent env ---
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored; never commit real keys.

# Mistral API key — get one at https://console.mistral.ai/api-keys/
# Used by `@ai-sdk/mistral` in src/agent/runtime.ts
MISTRAL_API_KEY=
AGENT_MODEL=mistral-medium-latest

# Optional — AGENT_MODEL overrides the Mistral model used by the agent.
# Defaults to "mistral-large-latest" inside src/agent/runtime.ts.

# --- Supabase (demo dataset) ---
# Project settings → API. The agent's data loader (src/agent/data/loader.ts)
# and the seed script (scripts/seed-supabase.mjs) read these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser. Bypasses RLS; used by the agent
# loader and `pnpm db:seed`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini variant (kept for quick rollback) ---
# Google Generative AI (Gemini) API key — get one at https://aistudio.google.com/apikey
# Used by `@ai-sdk/google` in src/agent/runtime.ts (currently commented out).
# GOOGLE_GENERATIVE_AI_API_KEY=
# AGENT_MODEL=gemini-2.0-flash
